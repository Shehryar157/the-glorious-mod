; Exported names (what the programs ask for) = our function names.
; 32-bit stdcall functions are decorated "@<bytes of arguments>".
LIBRARY version
EXPORTS
    GetFileVersionInfoA=Proxy_GetFileVersionInfoA@16
    GetFileVersionInfoW=Proxy_GetFileVersionInfoW@16
    GetFileVersionInfoExA=Proxy_GetFileVersionInfoExA@20
    GetFileVersionInfoExW=Proxy_GetFileVersionInfoExW@20
    GetFileVersionInfoSizeA=Proxy_GetFileVersionInfoSizeA@8
    GetFileVersionInfoSizeW=Proxy_GetFileVersionInfoSizeW@8
    GetFileVersionInfoSizeExA=Proxy_GetFileVersionInfoSizeExA@12
    GetFileVersionInfoSizeExW=Proxy_GetFileVersionInfoSizeExW@12
    VerFindFileA=Proxy_VerFindFileA@32
    VerFindFileW=Proxy_VerFindFileW@32
    VerInstallFileA=Proxy_VerInstallFileA@32
    VerInstallFileW=Proxy_VerInstallFileW@32
    VerLanguageNameA=Proxy_VerLanguageNameA@12
    VerLanguageNameW=Proxy_VerLanguageNameW@12
    VerQueryValueA=Proxy_VerQueryValueA@16
    VerQueryValueW=Proxy_VerQueryValueW@16
    loader_lua_state
    loader_main_thread
